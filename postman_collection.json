              "});",
              "",
              "pm.test(\"Content-Type header is application/json\", function () {",
              "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
              "});",
              "",
              "pm.test(\"Response matches JSON schema\", function () {",
              "    const schema = {\"type\": \"object\", \"required\": [\"data\"], \"properties\": {\"data\": {\"type\": \"array\", \"items\": {\"type\": \"object\", \"required\": [\"from_status\", \"to_status\", \"to_label\", \"created_at\"], \"properties\": {\"from_status\": {\"type\": [\"string\", \"null\"], \"enum\": [null, \"todo\", \"in_progress\", \"ready\", \"review\", \"done\"]}, \"to_status\": {\"type\": \"string\", \"enum\": [\"todo\", \"in_progress\", \"ready\", \"review\", \"done\"]}, \"to_label\": {\"type\": \"string\", \"enum\": [\"Belum Mulai\", \"Dikerjakan\", \"Siap Dicek\", \"Review\", \"Selesai\"]}, \"created_at\": {\"type\": \"string\", \"pattern\": \".*Z$\"}}}}}};",
              "    pm.response.to.have.jsonSchema(schema);",
              "});",
              "",
              "pm.test(\"Validate field values\", function () {",
              "    const jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an(\"array\");",
              "    pm.expect(jsonData.data.length).to.be.at.least(1);",
              "    pm.expect(jsonData.data[0].from_status).to.be.null;",
              "    pm.expect(jsonData.data[0].to_status).to.eql(\"todo\");",
              "    pm.expect(jsonData.data[0].to_label).to.eql(\"Belum Mulai\");",
              "    for (let i = 0; i < jsonData.data.length - 1; i++) {",
              "        const t1 = new Date(jsonData.data[i].created_at).getTime();",
              "        const t2 = new Date(jsonData.data[i + 1].created_at).getTime();",
              "        pm.expect(t1).to.be.at.most(t2);",
              "    }",
              "    jsonData.data.forEach(function (ev) {",
              "        pm.expect(ev.created_at).to.match(/Z$/);",
              "    });",
              "});"
            ]
          }
        }
